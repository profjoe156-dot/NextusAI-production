# Runtime
ENVIRONMENT=development
DEBUG=false
PUBLIC_BASE_URL=https://your-service.up.railway.app
PORT=8000
LOG_LEVEL=INFO

# Railway injects DATABASE_URL and REDIS_URL when services are referenced.
DATABASE_URL=postgresql+asyncpg://nexusai:nexusai@localhost:5432/nexusai
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# 1-256 characters: A-Z, a-z, 0-9, underscore, hyphen
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_token
TELEGRAM_WEBHOOK_PATH=/webhooks/telegram
TELEGRAM_MAX_CONNECTIONS=40
TELEGRAM_DROP_PENDING_UPDATES=false

# OpenAI
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=800
CHAT_HISTORY_MESSAGES=12

# Quotas and abuse controls
FREE_DAILY_MESSAGES=10
PREMIUM_DAILY_MESSAGES=500
RATE_LIMIT_REQUESTS=8
RATE_LIMIT_WINDOW_SECONDS=60

# Admin: generate the hash with scripts/hash_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-argon2-hash
SECRET_KEY=replace-with-at-least-64-random-characters
COOKIE_SECURE=true
ADMIN_SESSION_MINUTES=60

# Content worker
SCHEDULER_ENABLED=true
NEWS_REFRESH_MINUTES=30
NEWS_FEED_URLS=https://openai.com/news/rss.xml,https://www.anthropic.com/news/rss.xml

# Optional Telegram payments
PREMIUM_MONTHLY_PRICE_CENTS=999
PREMIUM_CURRENCY=USD
TELEGRAM_PAYMENT_PROVIDER_TOKEN=
